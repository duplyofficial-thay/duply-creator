# Duple tier — Thay-only. A new Duple gets its own duples/<name>/.env with
# this same shape: its own LINE OA credentials, its own rollout gates, its
# own calendar override if it uses one.

DUPLE_ID=thay               # identifies this Duple process — no default
SCHEMA_NAME=thay_ai         # derives to f"{DUPLE_ID}_ai" if unset — set explicitly anyway

LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Role-based rollout gates live in duple_settings.py (CHAT/REACH/MEMORY/
# KNOWLEDGE dicts, "gate_roles" key) — no env vars needed for gating.

GOOGLE_THAY_CALENDAR_ID=     # override for GOOGLE_CALENDAR_ID, this Duple's calendar
