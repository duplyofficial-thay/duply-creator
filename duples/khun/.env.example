# duples/khun/.env
# Copy this file to duples/khun/.env and fill in your credentials.
# This file is git-ignored — never commit the real .env.
#
# Postgres credentials (POSTGRES_HOST, POSTGRES_PASSWORD, etc.) are NOT here —
# they live in .env.platform (platform-tier secrets, sent separately by the Duply team).

# LINE OA credentials (from LINE Developers Console → this Duple's OA)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Duple identity (filled in by Duply team)
DUPLE_ID=khun
SCHEMA_NAME=khun_ai
WEBHOOK_SERVICE_PORT=8021
