# duples/dom/.env
# Copy this file to duples/dom/.env and fill in your credentials.
# This file is git-ignored — never commit the real .env.

# LINE OA credentials (from LINE Developers Console → this Duple's OA)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Duple identity (filled in by Duply team)
DUPLE_ID=dom
SCHEMA_NAME=dom_ai
WEBHOOK_SERVICE_PORT=     # assigned by team, e.g. 8021

# ── Database credentials ───────────────────────────────────────────────────────
# For direct schema access: Supabase Studio → Connect → Connection string,
# or psql -h $POSTGRES_HOST -U $POSTGRES_ROLE -d $POSTGRES_DB
# NOT used by the running service (which uses platform service_role keys).
# Store here so you always know where to find them.
POSTGRES_HOST=db.fpjevusrpausqunjhubk.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_SCHEMA=dom_ai
POSTGRES_ROLE=dom_role
POSTGRES_PASSWORD=    # sent by Duply team after provisioning
